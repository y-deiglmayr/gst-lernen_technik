{
  // Cloudflare Worker "technik": liefert die Technik-Lernpfade aus (statische Dateien, technik.physik.party)
  // und nimmt unter /api/feedback Rückmeldungen entgegen. Gemeinsame Datenbank D1 "gst-feedback" mit physik.party;
  // Technik-Einträge stehen mit dem Präfix /technik in der Spalte seite. Das tägliche Aufräumen macht der Physik-Worker.
  "name": "technik",
  "main": "feedback/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "gst-feedback", "database_id": "17e96367-7f67-4c99-b1f8-ff75f1f89423" }
  ],
  "observability": { "enabled": true }
}
